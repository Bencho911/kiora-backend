{
  "name": "activity-service",
  "version": "1.0.0",
  "description": "Activity logging microservice for Kiora",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:migrations": "echo 'No migration tests'",
    "audit:ci": "npm audit --audit-level=high",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix --max-warnings 0",
    "migrate:up": "node src/migrations/run.js up",
    "migrate:up:docker": "node src/migrations/run.js up"
  },
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
