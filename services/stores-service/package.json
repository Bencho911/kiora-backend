{
  "name": "stores-service",
  "version": "1.0.0",
  "description": "Microservicio de tiendas y mesas — Kiora Multi-Tienda",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "DB_USER=test DB_PASSWORD=test DB_HOST=test DB_PORT=5432 DB_NAME=test PORT=3000 jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix --max-warnings 0",
    "migrate:up": "node-pg-migrate up --envPath .env.local --migrations-dir src/db/migrations",
    "migrate:down": "node-pg-migrate down --envPath .env.local --migrations-dir src/db/migrations",
    "migrate:up:docker": "node-pg-migrate up --envPath .env.docker --migrations-dir src/db/migrations",
    "migrate:down:docker": "node-pg-migrate down --envPath .env.docker --migrations-dir src/db/migrations",
    "migrate:create": "node-pg-migrate create --envPath .env.local --migrations-dir src/db/migrations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.19.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
