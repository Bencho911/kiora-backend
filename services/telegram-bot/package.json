{
  "name": "telegram-bot",
  "version": "1.0.0",
  "description": "Bot de Telegram para notificaciones de Kiora",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsup src/index.ts --format cjs",
    "test": "jest",
    "test:migrations": "echo 'No migration tests'",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "lint:fix": "eslint 'src/**/*.{ts,js}' --fix",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@kiora/shared": "file:../shared",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1",
    "node-cron": "^4.2.1",
    "telegraf": "^4.16.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  },
  "tsup": {
    "noExternal": [
      "@kiora/shared"
    ]
  }
}
